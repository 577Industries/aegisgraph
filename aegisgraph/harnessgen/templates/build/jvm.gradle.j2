// auto-generated by aegisgraph harnessgen ({{ harness_id }})
//
// JVM fuzz-harness build recipe. Pulls ONLY the target's parser module
// + Jazzer -- NOT the full host application. Per Asemarefactor.md line
// 188 the design intent is a small, fast dep graph so the harness boots
// in seconds inside the HarnessGen sandbox.
//
// IMPORTANT (M5.1.b — to be pinned): the dependency versions below are
// PLACEHOLDER values selected to be plausible defaults. Real version
// pinning happens at M5.1.b once the extraction graph provides the
// dependency catalog. Do NOT rely on these versions for live fuzz runs.
//
// Build inside the HarnessGen sandbox image only — this Gradle file does
// NOT pull binaries from arbitrary network locations and does NOT probe
// live targets. Live fuzz runs are a self-hosted-runner concern.

plugins {
    id 'java'
    id 'application'
}

java {
    sourceCompatibility = JavaVersion.VERSION_{{ java_version }}
    targetCompatibility = JavaVersion.VERSION_{{ java_version }}
}

repositories {
    mavenCentral()
}

dependencies {
    // Jazzer API + driver. Version is a PLACEHOLDER; M5.1.b pins.
    implementation 'com.code-intelligence:jazzer-api:{{ jazzer_version }}'
    implementation 'com.code-intelligence:jazzer-junit:{{ jazzer_version }}'

    // Target's parser module ONLY -- not the full host app.
    // Version is a PLACEHOLDER; the extraction graph will resolve it at M5.1.b.
    implementation '{{ target_module }}:{{ target_module_version }}'
}

application {
    // The fuzzer main class is the entry point Jazzer launches.
    mainClass = '{{ fuzzer_main_class }}'
}

// The harness source lives next to this build.gradle so the default
// source-set picks it up.
sourceSets {
    main {
        java {
            srcDirs = ['.']
            include '{{ harness_source }}'
        }
    }
}
