# auto-generated by aegisgraph harnessgen ({{ harness_id }})
#
# Native fuzz-harness build recipe. ASAN + UBSan + libfuzzer per
# Asemarefactor.md line 226. Build inside the HarnessGen sandbox image
# only — this Makefile does NOT pull binaries from the network and does
# NOT probe live targets. Live fuzz runs are a self-hosted-runner concern.

CXX      ?= {{ compiler }}
CXXFLAGS ?= -O1 -g -std=c++17 \
            -fsanitize=address,undefined \
            -fsanitize=fuzzer \
            -fsanitize-coverage=trace-pc-guard \
            -fno-omit-frame-pointer
LDFLAGS  ?= -fsanitize=address,undefined -fsanitize=fuzzer

INCLUDES = {% for d in header_include_dirs %}-I{{ d }} {% endfor %}

LIBS     = {% for lib in link_libs %}-l{{ lib }} {% endfor %}


SRC = {{ harness_source }}
BIN = {{ harness_binary }}

.PHONY: all clean

all: $(BIN)

$(BIN): $(SRC)
	$(CXX) $(CXXFLAGS) $(INCLUDES) $(SRC) -o $(BIN) $(LIBS) $(LDFLAGS)

clean:
	rm -f $(BIN) *.o
