{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://577.industries/aegisgraph/schema/fact-vector.schema.v2.proposed.json",
  "title": "PolyDiff URL Fact Vector v2 (proposed)",
  "description": "Additive successor to fact-vector.schema.json. Backwards-compatible with v1: every v1 field remains required; v2 adds ~30 axes that may be null (with an explanatory warning) when a parser cannot directly observe them. See docs/decision-log/0020-factvec-v2-migration.md for the migration plan and policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_id",
    "parser_profile",
    "scheme",
    "host",
    "port",
    "path",
    "userinfo_present",
    "host_is_private_or_link_local",
    "parse_error",
    "parsed",
    "errors",
    "warnings"
  ],
  "properties": {
    "input_id": {"type": "string", "minLength": 1},
    "parser_profile": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string"},
    "parsed": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "scheme": {"type": ["string", "null"]},
    "scheme_lowercased": {"type": ["string", "null"]},
    "userinfo_present": {"type": "boolean"},
    "userinfo_raw": {"type": ["string", "null"]},
    "username": {"type": ["string", "null"]},
    "password_present": {"type": ["boolean", "null"]},
    "host": {"type": ["string", "null"]},
    "host_raw": {"type": ["string", "null"]},
    "host_lowercased": {"type": ["string", "null"]},
    "host_decoded": {"type": ["string", "null"]},
    "host_is_ip_literal": {"type": ["boolean", "null"]},
    "host_is_ipv4": {"type": ["boolean", "null"]},
    "host_is_ipv6": {"type": ["boolean", "null"]},
    "host_is_ipvFuture": {"type": ["boolean", "null"]},
    "host_is_loopback": {"type": ["boolean", "null"]},
    "host_is_private_or_link_local": {"type": "boolean"},
    "host_has_idn": {"type": ["boolean", "null"]},
    "host_punycode": {"type": ["string", "null"]},
    "port": {"type": ["integer", "null"]},
    "port_present": {"type": ["boolean", "null"]},
    "port_value": {"type": ["integer", "null"]},
    "port_default_inferred": {"type": ["integer", "null"]},
    "path": {"type": ["string", "null"]},
    "path_raw": {"type": ["string", "null"]},
    "path_normalized": {"type": ["string", "null"]},
    "path_traversal_resolved": {"type": ["boolean", "null"]},
    "query_raw": {"type": ["string", "null"]},
    "query_pairs": {"type": ["array", "null"], "items": {"type": "object"}},
    "fragment_raw": {"type": ["string", "null"]},
    "percent_decoding_applied_in_host": {"type": ["boolean", "null"]},
    "percent_decoding_applied_in_path": {"type": ["boolean", "null"]},
    "trailing_slash_normalized": {"type": ["boolean", "null"]},
    "leading_zeroes_in_octets_stripped": {"type": ["boolean", "null"]},
    "tab_or_newline_stripped": {"type": ["boolean", "null"]},
    "backslash_treated_as_slash": {"type": ["boolean", "null"]},
    "control_chars_in_host_rejected": {"type": ["boolean", "null"]},
    "scheme_authority_separator_strict": {"type": ["boolean", "null"]},
    "raw_serialized": {"type": ["string", "null"]},
    "parse_error": {"type": ["string", "null"]}
  }
}
