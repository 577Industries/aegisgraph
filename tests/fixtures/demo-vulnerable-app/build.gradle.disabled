// Synthetic ground-truth fixture for InvariantCheck library v3.
// Not based on any real product code.
//
// DISABLED (renamed from build.gradle, 2026-09-01): the ground-truth
// harness now builds its CodeQL database with `--build-mode=none`, and
// CodeQL 2.20.6's buildless extractor FATALLY requires its Gradle
// classpath probe to succeed whenever a build.gradle is visible — but
// this fixture deliberately does not build (and the runner's Gradle 9.x
// wrapper refuses the JVM 11 this file advertises). Renaming it makes
// buildless extraction pure source parsing, which succeeds. Restore the
// name only if the harness returns to a real compile step.

apply plugin: 'java'

sourceCompatibility = '11'
targetCompatibility = '11'

sourceSets {
    main {
        java {
            srcDirs = ['src/main/java', 'fixtures']
        }
    }
}

repositories {
    mavenCentral()
    google()
}

dependencies {
    // No runtime dependencies — the fixture compiles against synthetic
    // stubs only. CodeQL extraction works against the source on disk
    // without resolving these to real artifacts.
}
