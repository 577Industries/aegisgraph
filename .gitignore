__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
*.pyc

# Parallel-stream isolation: per-stream worktrees live under .worktrees/ but
# must never be committed to the parent branch. Each worktree has its own
# checkout, branch, and node_modules symlink.
.worktrees/

tooling-versions.json
validation-report.json

# Crash-inducing or undisclosed inputs never belong in the public/private repo
# history. Store only hashes, structure notes, and manually approved summaries.
reprochain/corpora-private/*
!reprochain/corpora-private/.gitkeep
!reprochain/corpora-private/README.md
!reprochain/corpora-private/handcrafted/
reprochain/corpora-private/handcrafted/*
!reprochain/corpora-private/handcrafted/README.md
!reprochain/corpora-private/handcrafted/MANIFEST.json

# Build artifacts from reprochain/build.sh — vulnerable static archive
# and harness binaries are NEVER committed. Worktrees of the libwebp
# pinned commits live alongside the upstream submodule and are also
# transient build artifacts.
reprochain/vendor/libwebp/build-vuln/
reprochain/vendor/libwebp/build-fix/
reprochain/vendor/libwebp/cmake-vuln/
reprochain/vendor/libwebp/cmake-fix/

# ASan logs may contain stack frames with developer-host paths and (for
# the vuln binary) bytes adjacent to the crash address. Only the
# scrubbed asan_report_summary.json is committed; raw asan_*.txt logs
# stay out of git.
reprochain/evidence/asan_*.txt

# Generated exports are reproducible outputs, not source of truth.
exports/private-submission/*
!exports/private-submission/README.md
exports/public-sanitized/*
!exports/public-sanitized/README.md
# Reviewer packets are reproducible from `make reviewer-packet`; the per-ISO
# date subdirectories are not committed (the manifest is byte-stable enough
# that committing the bundle would only grow with each rebuild).
exports/reviewer-packet/
# Reviewer claim-state promotions are session-local; the workbench writes a
# new file per promotion. They're additive (ADR-0010) and reproducible from
# the parent record_hash + the claim-state delta. Not source-of-truth.
aegisgraph/workbench/promotions/

smabench/results/latest/
# Also ignore the symlink form (trailing slash above only matches dirs).
smabench/results/latest
reports/generated/

# Phase 1 extraction outputs that are LARGE or contain target source paths.
# Only the normalized graph/coverage/manifest JSON is committed; raw scanner
# output and CodeQL DBs are reproducible from build_db.sh + run_queries.sh.
extraction/output/*/raw/
extraction/output/*/codeql-db/
# Per-target intermediate adapter inputs are also reproducible — only commit
# the normalized graph.json + coverage.json. The mobsf/manifest JSON sits in
# the same per-target dir and is regenerated by their respective runners.
extraction/output/*/manifest-analysis.json
extraction/output/*/mobsf-results.json
