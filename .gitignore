__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
*.pyc

# Parallel-stream isolation: per-stream worktrees live under .worktrees/ but
# must never be committed to the parent branch. Each worktree has its own
# checkout, branch, and node_modules symlink.
.worktrees/

tooling-versions.json
validation-report.json

# Crash-inducing or undisclosed inputs never belong in the public/private repo
# history. Store only hashes, structure notes, and manually approved summaries.
reprochain/corpora-private/*
!reprochain/corpora-private/.gitkeep
!reprochain/corpora-private/README.md

# Generated exports are reproducible outputs, not source of truth.
exports/private-submission/*
!exports/private-submission/README.md
exports/public-sanitized/*
!exports/public-sanitized/README.md

smabench/results/latest/
reports/generated/

# Phase 1 extraction outputs that are LARGE or contain target source paths.
# Only the normalized graph/coverage/manifest JSON is committed; raw scanner
# output and CodeQL DBs are reproducible from build_db.sh + run_queries.sh.
extraction/output/*/raw/
extraction/output/*/codeql-db/
# Per-target intermediate adapter inputs are also reproducible — only commit
# the normalized graph.json + coverage.json. The mobsf/manifest JSON sits in
# the same per-target dir and is regenerated by their respective runners.
extraction/output/*/manifest-analysis.json
extraction/output/*/mobsf-results.json
