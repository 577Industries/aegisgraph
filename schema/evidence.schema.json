{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://577.industries/aegisgraph/schema/evidence.schema.json",
  "title": "AegisGraph Tier 3 Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "target",
    "path_class",
    "nodes",
    "edges",
    "score_vector",
    "claim_state",
    "validation_task",
    "evidence_refs",
    "recommendation_refs",
    "limitations",
    "provenance",
    "safety_flags",
    "hash_chain"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AG-EV-[A-Z0-9-]+$"
    },
    "version": {
      "const": "v1.0"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "path_class": {
      "enum": [
        "inbound_message",
        "media_decode",
        "link_preview",
        "deeplink",
        "qr_device_link",
        "sync_state",
        "crypto_key_lifecycle",
        "native_boundary"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "score_vector": {
      "$ref": "#/$defs/score_vector"
    },
    "claim_state": {
      "enum": [
        "observed",
        "anchored",
        "scored",
        "validation_tasked",
        "reviewed",
        "reviewed_embargoed",
        "disclosed_public",
        "accepted",
        "limited",
        "retired"
      ]
    },
    "disclosure_status": {
      "type": ["string", "null"],
      "enum": [
        null,
        "public_historical",
        "patched_public",
        "not_applicable",
        "private_review",
        "disclosed_pending_patch",
        "embargoed",
        "disclosed_public",
        "disclosed_patched"
      ],
      "default": null
    },
    "discovery_engine": {
      "type": ["string", "null"],
      "enum": [
        null,
        "polydiff",
        "harnessgen",
        "invariantcheck",
        "crosssma",
        "dynamicprobe",
        "reprochain",
        "disclosure",
        "manual"
      ],
      "default": null
    },
    "finding_type": {
      "type": ["string", "null"],
      "enum": [
        null,
        "reachability_observation",
        "differential_disagreement",
        "invariant_violation",
        "harness_crash",
        "cross_target_candidate",
        "disclosure_event",
        "novel_private_candidate"
      ],
      "default": null
    },
    "validation_task": {
      "$ref": "#/$defs/validation_task"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "recommendation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "string",
      "minLength": 10
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "safety_flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safety_flag"
      }
    },
    "hash_chain": {
      "$ref": "#/$defs/hash_chain"
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repo_url", "commit", "source_policy"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo_url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 4
        },
        "source_policy": {
          "enum": ["anchor-only", "vendored-library", "synthetic"]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_type", "label", "source_anchor", "evidence_source"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "node_type": {
          "enum": [
            "entry_point",
            "handler",
            "parser",
            "decoder",
            "native_boundary",
            "sink",
            "control",
            "validation_task",
            "parser_profile",
            "fact_vector",
            "discovery_run",
            "crash",
            "disagreement",
            "invariant_violation",
            "cross_target_candidate",
            "disclosure_event"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_anchor": {
          "type": "string",
          "minLength": 1
        },
        "evidence_source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relationship"],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "score_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_reachability",
        "attacker_control",
        "parser_complexity",
        "native_boundary",
        "auth_boundary",
        "privilege_impact",
        "exploit_history",
        "mitigation_strength",
        "observability",
        "confidence",
        "total"
      ],
      "properties": {
        "remote_reachability": {"type": "number", "minimum": 0, "maximum": 1},
        "attacker_control": {"type": "number", "minimum": 0, "maximum": 1},
        "parser_complexity": {"type": "number", "minimum": 0, "maximum": 1},
        "native_boundary": {"type": "number", "minimum": 0, "maximum": 1},
        "auth_boundary": {"type": "number", "minimum": 0, "maximum": 1},
        "privilege_impact": {"type": "number", "minimum": 0, "maximum": 1},
        "exploit_history": {"type": "number", "minimum": 0, "maximum": 1},
        "mitigation_strength": {"type": "number", "minimum": 0, "maximum": 1},
        "observability": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "total": {"type": "number", "minimum": 0, "maximum": 10},
        "engine_corroboration": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "default": null},
        "exploitability_evidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "default": null}
      }
    },
    "validation_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "expected_output", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "expected_output": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["planned", "ready", "passing", "blocked", "not_applicable"]
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool", "version", "command", "output_hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "output_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "generated_at", "source", "private_by_default"],
      "properties": {
        "generated_by": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "private_by_default": {"type": "boolean"}
      }
    },
    "safety_flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "level", "message", "decision"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "level": {"enum": ["info", "warning", "blocking"]},
        "message": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1}
      }
    },
    "hash_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "previous_hash", "record_hash"],
      "properties": {
        "canonicalization": {"const": "json-v1-sorted-no-hash-chain"},
        "previous_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
